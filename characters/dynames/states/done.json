{
  "note": "做完了：轉身背對，GN 引擎噴出粒子（10/30 改成腳本；原本是力天使模組的 drive 演出，數值照搬）。back 第 0 格；引擎發光的位置是建置時量的 rig.driveAt。一進狀態先大噴一下（gush，0.9 秒內退掉），之後光暈每 1.6 秒呼吸一次。圖是 Wars 的 GN 特效（assets/drive/）。",
  "params": [],
  "script": {
    "loop": false,
    "moveWhileActing": true,
    "timeline": [{"do": "frame", "anim": "back", "frame": 0}],
    "vars": {
      "on": "min(1, st/0.15)",
      "gush": "max(0, 1 - st/0.9)",
      "breath": "0.5 + 0.5*sin(st*2*pi/1.6)"
    },
    "layers": [
      {"image": "drive/flare", "at": "driveAt", "size": [0.62, 0.62],
       "scale": "(0.75 + 0.15*breath + 0.7*gush)*on", "opacity": "min(1, (0.4 + 0.2*breath + 0.6*gush)*on)"},
      {"image": "drive/core", "at": "driveAt", "size": [0.2, 0.2],
       "scale": "0.9 + 0.2*breath", "opacity": "(0.25 + 0.1*breath)*on"}
    ],
    "emitters": [
      {"at": "driveAt", "size": 0.16, "render": "oldestFirst",
       "birthRate": "on*(1 + 3*gush)", "velocity": "1 + 0.8*gush",
       "cells": [
         {"image": "drive/puff", "rate": 6, "life": 1.6, "lifeRange": "1.6*0.3", "velocity": "0.3*h", "velocityRange": "0.3*h*0.6",
          "range": "2*pi", "yAccel": "-0.32*h", "scale": "0.014*h", "scaleRange": "0.014*h*0.4", "scaleSpeed": "-0.014*h*0.35",
          "alphaSpeed": -0.55, "color": [1, 1, 1, 0.4]},
         {"image": "drive/dot", "rate": 90, "life": 1.9, "lifeRange": "1.9*0.3", "velocity": "0.5*h", "velocityRange": "0.5*h*0.6",
          "range": "2*pi", "yAccel": "-0.32*h", "scale": "0.016*h", "scaleRange": "0.016*h*0.4", "scaleSpeed": "-0.016*h*0.35",
          "alphaSpeed": -0.5, "color": [1, 1, 1, 0.75]},
         {"image": "drive/star", "rate": 14, "life": 1.2, "lifeRange": "1.2*0.3", "velocity": "0.42*h", "velocityRange": "0.42*h*0.6",
          "range": "2*pi", "yAccel": "-0.32*h", "scale": "0.009*h", "scaleRange": "0.009*h*0.4", "scaleSpeed": "-0.009*h*0.35",
          "alphaSpeed": -0.8, "spin": 2, "spinRange": 4}
       ]}
    ]
  }
}
