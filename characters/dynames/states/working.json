        {"name": "face", "image": "cutin/face", "gravity": "fill", "opacity": 0},
        {"name": "eye", "image": "cutin/eye", "gravity": "fill", "opacity": 0},
        {"name": "cutinTint", "image": "cutin/tint", "blend": "multiply", "opacity": 0},
