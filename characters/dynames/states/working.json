        {"name": "cutArc3", "image": "cutin/arc_a", "size": ["0.95*0.62*0.5", "0.95*0.62*0.45"], "trilinear": true, "opacity": 0},
        {"name": "scanLine", "image": "cutin/line", "frame": [0, 0, "1.6*h", 8], "center": true, "opacity": 0},
