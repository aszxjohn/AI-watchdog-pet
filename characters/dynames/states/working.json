      {"name": "fxSpark", "in": "root", "image": "transam/fx_spark", "size": 0.5},
      {"name": "smokeA", "in": "root", "image": "attack/smokeA", "size": 0.7},
      {"name": "smokeB", "in": "root", "image": "attack/smokeB", "size": 0.7},
      {"name": "fireC", "in": "root", "image": "attack/fireC", "size": 0.75},
      {"name": "fireA", "in": "root", "image": "attack/fireA", "size": 0.5},
      {"name": "fireB", "in": "root", "image": "attack/fireB", "size": 0.5},
