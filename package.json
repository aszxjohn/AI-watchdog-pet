{
  "name": "ai-watchdog-pet",
  "productName": "AI Watchdog Pet",
  "version": "1.0.0",
  "private": true,
  "description": "把 AI coding session 的狀態變成桌面寵物",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "john_tsai_java",
    "email": ""
  },
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint --deny-warnings src test prototypes forge.config.mts vite.main.config.mts vite.preload.config.mts vite.renderer.config.mts && oxfmt --check src test prototypes \"*.mts\"",
    "lint:fix": "oxlint --fix src test prototypes forge.config.mts vite.main.config.mts vite.preload.config.mts vite.renderer.config.mts && oxfmt --write src test prototypes \"*.mts\"",
    "typecheck": "tsc --noEmit",
    "proto:sandbox": "vite build --config prototypes/sandbox/vite.config.mts && node prototypes/sandbox/main.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "electron": "45.2.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.91.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "pixi.js": "8.22.0",
    "ses": "2.3.0"
  }
}
